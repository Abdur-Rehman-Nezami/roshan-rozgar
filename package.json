{
  "name": "roshan-rozgar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node scripts/dev.mjs",
    "db:migrate": "node scripts/run-task.mjs db:migrate",
    "db:seed": "node scripts/run-task.mjs db:seed",
    "test": "node --conditions=development --test --test-isolation=none scripts/test/*.test.mjs packages/shared/test/*.test.mjs apps/server/test/*.test.mjs",
    "e2e": "node scripts/run-task.mjs e2e",
    "audio:build": "node scripts/run-task.mjs audio:build",
    "eval:triage": "node scripts/run-task.mjs eval:triage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "drizzle-kit": "^0.31.8"
  },
  "dependencies": {
    "pg": "8.21.0"
  }
}
