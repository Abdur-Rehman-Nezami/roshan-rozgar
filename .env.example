NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:5173
# Production: your domain or <ip-with-dashes>.sslip.io
DOMAIN=
DATABASE_URL=postgres://rr:rr@localhost:5432/rr
REDIS_URL=redis://localhost:6379
# Generate locally, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DEMO_KEY=
UPLOAD_DIR=./data/uploads
TTS_DIR=./data/tts
CITY_DEFAULT=islamabad
TZ=Asia/Karachi

# fake | live | off; no provider credentials are needed for fake/off.
AI_MODE=fake
ANTHROPIC_API_KEY=
# Proposed in BUILD_PLAN.md; verify availability during F-08.
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-transcribe
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE_UR=ur-PK-UzmaNeural
TTS_VOICE_EN=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
